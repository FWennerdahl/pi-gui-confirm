{
  "allowedTools": [
    { "name": "list_threads" },
    { "name": "read_thread" },
    { "name": "list_scheduled_tasks" },
    { "name": "mcp__slack__slack_search_public_and_private" },
    { "name": "mcp__slack__slack_read_thread" },
    { "name": "mcp__slack__slack_read_file" },
    { "name": "mcp__linear__get_issue" },
    { "name": "read", "paths": { "path": "read" } },
    { "name": "grep", "paths": { "path": "read" } },
    { "name": "find", "paths": { "path": "read" } },
    { "name": "ls", "paths": { "path": "read" } },
    { "name": "edit", "paths": { "path": "write" } },
    { "name": "write", "paths": { "path": "write" } }
  ],
  "protectedPaths": [".git", ".pi", ".envrc", "package.json", "node_modules", ".npmrc"],
  "allowedBashCommands": [
    "ls( .*)?",
    "git (status|log|diff|show|blame|ls-files|rev-parse)( .*)?",
    "head( .*)?",
    "tail( .*)?",
    "cat( .*)?",
    "wc( .*)?",
    "cd( .*)?",
    "npm run( -s)? typecheck"
  ],
  "excludedBashCommands": [
    {
      "pattern": ".* --output(=\\S*)?( .*)?",
      "reason": "--output writes the result to a file"
    },
    {
      "pattern": "ls( .*)? -\\w*L.*",
      "reason": "-L follows symlinks while recursing, also to outside the session folder"
    },
    {
      "pattern": "ls( .*)? --dereference( .*)?",
      "reason": "--dereference follows symlinks while recursing, also to outside the session folder"
    },
    {
      "pattern": "tail( .*)? -\\w*[fF].*",
      "reason": "-f/-F keeps waiting for new lines and never finishes"
    },
    {
      "pattern": "tail( .*)? --follow(=\\S*)?( .*)?",
      "reason": "--follow keeps waiting for new lines and never finishes"
    }
  ],
  "bashValidators": {
    "grep": "grep",
    "echo": "any-arguments",
    "pwd": "any-arguments"
  }
}
